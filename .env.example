# Google Gemini API Key
GEMINI_API_KEY=your_google_gemini_api_key_here

# Selected Gemini Model
GEMINI_MODEL=gemini-3.6-flash

# Database Settings
DATABASE_PATH=backend/app/edumate.db

# Supabase / PostgreSQL Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Settings
UPLOAD_DIR=backend/app/uploads

# Optional SMTP settings for emailing mock interview reports to the signed-in account email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=your_verified_sender@example.com
SMTP_USE_TLS=true
